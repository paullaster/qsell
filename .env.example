# =============================================================================
# qsell Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=https://qsell.com
NEXT_PUBLIC_APP_NAME=qsell

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://qsell:${POSTGRES_PASSWORD}@postgres:5432/qsell?connection_limit=20&pool_timeout=10&sslmode=prefer
POSTGRES_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=your_secure_redis_password_here

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=your_nextauth_secret_at_least_32_chars
NEXTAUTH_URL=https://qsell.com
JWT_SECRET=your_jwt_secret_at_least_32_chars

# -----------------------------------------------------------------------------
# Payment Providers (Production)
# -----------------------------------------------------------------------------
# M-Pesa Daraja
MPESA_DARAJA_CONSUMER_KEY=your_consumer_key
MPESA_DARAJA_CONSUMER_SECRET=your_consumer_secret
MPESA_DARAJA_PASSKEY=your_passkey
MPESA_DARAJA_SHORTCODE=your_shortcode
MPESA_DARAJA_ENVIRONMENT=production
MPESA_DARAJA_CALLBACK_URL=https://qsell.com/api/payments/mpesa/daraja/stk/callback

# Pesapal
PESAPAL_CONSUMER_KEY=your_consumer_key
PESAPAL_CONSUMER_SECRET=your_consumer_secret
PESAPAL_ENVIRONMENT=production
PESAPAL_CALLBACK_URL=https://qsell.com/api/payments/pesapal/ipn

# Jenga HQ
JENGA_CONSUMER_KEY=your_consumer_key
JENGA_CONSUMER_SECRET=your_consumer_secret
JENGA_ENVIRONMENT=production
JENGA_CALLBACK_URL=https://qsell.com/api/payments/jenga/callback

# KCB Buni
KCB_BUNI_CONSUMER_KEY=your_consumer_key
KCB_BUNI_CONSUMER_SECRET=your_consumer_secret
KCB_BUNI_ENVIRONMENT=production
KCB_BUNI_CALLBACK_URL=https://qsell.com/api/payments/kcb-buni/stk/callback

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=smtp.sendgrid.net
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=apikey
EMAIL_SMTP_PASSWORD=your_sendgrid_api_key
EMAIL_FROM=noreply@qsell.com
EMAIL_FROM_NAME=qsell

# -----------------------------------------------------------------------------
# File Storage (S3/MinIO)
# -----------------------------------------------------------------------------
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=qsell-assets
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_PUBLIC_URL=https://qsell-assets.s3.amazonaws.com

# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------
DATA_ENCRYPTION_KEY=your_32_byte_base64_encoded_key
PAYMENT_DATA_KEY=your_32_byte_base64_encoded_key

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
GRAFANA_PASSWORD=your_grafana_admin_password
