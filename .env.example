# =============================================================================
# Local runtime environment template. Copy to .env.runtime.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=https://omnicommerce.brainsporellc.com
NEXT_PUBLIC_APP_NAME=qsell

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://qsell:URL_ENCODED_PASSWORD@db:5432/qsell

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
AUTH_SECRET=generate-a-unique-value-with-openssl-rand-base64-32
AUTH_URL=https://omnicommerce.brainsporellc.com
NEXTAUTH_URL=https://omnicommerce.brainsporellc.com
# The deploy workflow passes this as a Docker build argument (not a runtime setting).
SERVER_ACTION_ALLOWED_ORIGINS=omnicommerce.brainsporellc.com
JWT_SECRET=your_jwt_secret_at_least_32_chars
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-unique-strong-password
SUPER_ADMIN_NAME=Super Admin

# -----------------------------------------------------------------------------
# Payment Providers (Production)
# -----------------------------------------------------------------------------
# M-Pesa Daraja
MPESA_DARAJA_CONSUMER_KEY=your_consumer_key
MPESA_DARAJA_CONSUMER_SECRET=your_consumer_secret
MPESA_DARAJA_PASSKEY=your_passkey
MPESA_DARAJA_SHORTCODE=your_shortcode
MPESA_DARAJA_ENVIRONMENT=production
MPESA_DARAJA_CALLBACK_URL=https://omnicommerce.brainsporellc.com/api/payments/mpesa/daraja/stk/callback

# Pesapal
PESAPAL_CONSUMER_KEY=your_consumer_key
PESAPAL_CONSUMER_SECRET=your_consumer_secret
PESAPAL_ENVIRONMENT=production
PESAPAL_CALLBACK_URL=https://omnicommerce.brainsporellc.com/api/payments/pesapal/ipn

# Jenga HQ
JENGA_CONSUMER_KEY=your_consumer_key
JENGA_CONSUMER_SECRET=your_consumer_secret
JENGA_ENVIRONMENT=production
JENGA_CALLBACK_URL=https://omnicommerce.brainsporellc.com/api/payments/jenga/callback

# KCB Buni
KCB_BUNI_CONSUMER_KEY=your_consumer_key
KCB_BUNI_CONSUMER_SECRET=your_consumer_secret
KCB_BUNI_ENVIRONMENT=production
KCB_BUNI_CALLBACK_URL=https://omnicommerce.brainsporellc.com/api/payments/kcb-buni/stk/callback

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=smtp.sendgrid.net
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=apikey
EMAIL_SMTP_PASSWORD=your_sendgrid_api_key
EMAIL_FROM=noreply@brainsporellc.com
EMAIL_FROM_NAME=qsell

# -----------------------------------------------------------------------------
# File Storage (S3/MinIO)
# -----------------------------------------------------------------------------
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=qsell-assets
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_PUBLIC_URL=https://qsell-assets.s3.amazonaws.com

# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------
DATA_ENCRYPTION_KEY=your_32_byte_base64_encoded_key
PAYMENT_DATA_KEY=your_32_byte_base64_encoded_key

# -----------------------------------------------------------------------------
# Optional monitoring
# -----------------------------------------------------------------------------
# Email and object-storage values above are optional unless those integrations are enabled.
# Sentry: NEXT_PUBLIC_SENTRY_DSN must be available at build time; SENTRY_DSN is read at runtime.
# The org/project slugs live in next.config.ts, so only the DSNs are configured here.
# Source-map upload is optional and requires the SENTRY_AUTH_TOKEN CI secret.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_AUTH_TOKEN is a CI-only secret; never commit an actual value.
