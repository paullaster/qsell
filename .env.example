# APP_URL: Public URL of this OmniCommerce instance (callbacks / self-links).
APP_URL="http://localhost:3000"

# PostgreSQL connection for Drizzle ORM.
DATABASE_URL="postgres://qsell:qsell@127.0.0.1:5432/qsell"

# Auth.js (NextAuth v5) — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# First admin account (seeded if missing)
ADMIN_EMAIL="admin@omnicommerce.ke"
ADMIN_PASSWORD="ChangeMeAdmin123!"
ADMIN_NAME="Admin"

# AES-256-GCM key for sealing payment provider credentials (32-byte base64).
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=""

# Invoice PDF adapter: pdfkit
PDF_DRIVER="pdfkit"

# Email adapter: console (dev logs) | smtp (nodemailer)
EMAIL_DRIVER="console"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="OmniCommerce Billing <billing@omnicommerce.ke>"
