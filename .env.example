# APP_URL: Public URL of this OmniCommerce instance (callbacks / self-links).
APP_URL="http://localhost:3000"

# PostgreSQL connection for Drizzle ORM.
DATABASE_URL="postgres://qsell:qsell@127.0.0.1:5432/qsell"

# Auth.js (NextAuth v5) — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Super admin (always seeded from env on login / staff access — full system power)
# Prefer SUPER_ADMIN_*; ADMIN_* kept as fallback for compatibility.
SUPER_ADMIN_EMAIL="superadmin@omnicommerce.ke"
SUPER_ADMIN_PASSWORD="ChangeMeSuperAdmin123!"
SUPER_ADMIN_NAME="Super Admin"
ADMIN_EMAIL="superadmin@omnicommerce.ke"
ADMIN_PASSWORD="ChangeMeSuperAdmin123!"
ADMIN_NAME="Super Admin"

# AES-256-GCM key for sealing payment provider credentials (32-byte base64).
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=""

# Invoice PDF adapter: pdfkit
PDF_DRIVER="pdfkit"

# Email adapter: console (dev logs) | smtp (nodemailer)
EMAIL_DRIVER="console"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="OmniCommerce Billing <billing@omnicommerce.ke>"
