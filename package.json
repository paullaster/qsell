{
  "name": "omnicommerce",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "drizzle-kit migrate",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "db:push": "echo \"db:push is disabled: drizzle-kit push cannot handle this schema (the partitioned gl_entries table) and would drop its partitions. Use db:generate then db:migrate.\" && exit 1",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "worker": "tsx src/server/queue/index.ts",
    "media:verify": "tsx scripts/verify-cloudinary-adapter.ts",
    "media:check": "tsx scripts/check-media-provider.ts",
    "media:purge": "tsx scripts/purge-media.ts"
  },
  "dependencies": {
    "@node-rs/bcrypt": "^1.10.9",
    "@sentry/nextjs": "^11.7.0",
    "@sentry/profiling-node": "11.7.0",
    "cloudinary": "^2.11.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "graphile-worker": "^0.18.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.3"
  }
}
