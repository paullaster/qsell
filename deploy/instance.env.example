# One file per installation. Copy to deploy/instances/<INSTANCE_ID>.env (git-ignored)
# and fill it in. Every script reads it with --config <file>; any value can instead
# be passed as an environment variable. No secrets belong here — only names, paths
# and locations. Defaults are shown in comments.

# ── Identity ────────────────────────────────────────────────────────────────
# Lowercase letters, digits, hyphens. Becomes the GitHub Environment name and the
# Nginx snippet name.
INSTANCE_ID=new-shop
# Bare hostname customers will use (no https://, no trailing slash).
PUBLIC_DOMAIN=shop.example.com

# ── Host ────────────────────────────────────────────────────────────────────
# IP or DNS name GitHub Actions will SSH to.
DEPLOY_HOST=203.0.113.10
# Account that owns the instance directory and runs Docker Compose.
DEPLOY_USER=deploy
# Root for all instances on the host.            (default: /opt/qsell)
#APP_DIR=/opt/qsell
# Absolute instance directory.                   (default: $APP_DIR/instances/$INSTANCE_ID)
#DEPLOY_PATH=/opt/qsell/instances/new-shop
# Unique per instance on the same host.          (default: qsell-$INSTANCE_ID)
#COMPOSE_PROJECT_NAME=qsell-new-shop
# Loopback port Caddy listens on; unique per instance on one host.  (default: 8080)
#EDGE_HTTP_PORT=8080

# ── Application ─────────────────────────────────────────────────────────────
# Initial super-admin login created on first start.
ADMIN_EMAIL=admin@example.com
# local = files on the host volume, cloudinary = Cloudinary (then add credentials to
# the instance's .env.runtime).                   (default: local)
#MEDIA_DRIVER=local

# ── TLS ─────────────────────────────────────────────────────────────────────
# Email Let's Encrypt uses for expiry notices.
CERT_EMAIL=ops@example.com

# ── GitHub (used by scripts/configure-github-environment.sh, run on your laptop) ──
# owner/name of the repository that builds the images.
GITHUB_REPO=your-org/qsell
# GitHub user that owns the read token for pulling private GHCR images.
GHCR_USERNAME=your-github-user
# Where the passphrase-less deploy key lives on YOUR machine (created if missing
# when --generate-key is passed). Private half goes to the GitHub Environment only.
SSH_KEY_FILE=~/.ssh/qsell_new-shop
